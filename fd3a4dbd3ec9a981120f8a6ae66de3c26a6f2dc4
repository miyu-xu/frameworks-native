              "replacement": "static void DumpKernelMemoryAllocations(int out_fd) {\n    std::string title \u003d \"KERNEL MEMORY ALLOCATIONS\";\n    DurationReporter duration_reporter(title, true);\n\n    std::ifstream ifs(\"/proc/allocinfo\");\n    std::string line;\n    while (std::getline(ifs, line)) {\n        std::vector\u003cstd::string\u003e parts \u003d android::base::Split(line, \u0027 \u0027);\n        if (parts.size() \u003c 3) {\n            continue;\n        }\n        uint64_t size;\n        if (!android::base::ParseUint(parts[2], \u0026size)) {\n            continue;\n        }\n        if (size \u003c KERNEL_MEMORY_ALLOCATION_MIN_SIZE) {\n            continue;\n        }\n        ds.AddTextZipEntry(title + \" - \" + parts[0], line);\n    }\n"
