      "writtenOn": "2024-05-20T21:02:11Z",
      "side": 1,
      "message": "Why is this part necessary?  It looks like this is overriding the SELinux context that was assigned by `restorecon_app_data_lazy()`.  Would it perhaps make more sense to make `restorecon_app_data_lazy()` assign the correct context?",
      "range": {
        "startLine": 868,
        "startChar": 15,
        "endLine": 868,
        "endChar": 62
