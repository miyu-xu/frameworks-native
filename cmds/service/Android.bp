package {
    default_applicable_licenses: ["frameworks_native_cmds_service_license"],
}

// Added automatically by a large-scale-change
// See: http://go/android-license-faq
license {
    name: "frameworks_native_cmds_service_license",
    visibility: [":__subpackages__"],
    license_kinds: [
        "SPDX-license-identifier-Apache-2.0",
    ],
    license_text: [
        "NOTICE",
    ],
}

cc_defaults {
    name: "service_defaults",

    srcs: [
        "service.cpp",
        "utils.cpp",
    ],

    shared_libs: [
        "libcutils",
        "libutils",
        "libbinder",
    ],

    cflags: [
        "-Wall",
        "-Werror",
    ],
}

cc_binary {
    name: "service",
    defaults: ["service_defaults"],
}

cc_binary {
    name: "vndservice",
    defaults: ["service_defaults"],
    proprietary: true,
    cflags: [
        "-DVENDORSERVICES",
    ],
}

cc_binary_host {
    name: "aservice",
    defaults: ["service_defaults"],
}
